# Node 后端直接调用 Anthropic Messages 兼容 API，无需安装 Claude Code。
CLAUDE_MODE=api
# 当前项目沿用原来的 DeepSeek V4 Pro 路由与推理级别。
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
CLAUDE_MODEL=deepseek-v4-pro
CLAUDE_API_EFFORT=max
CLAUDE_MAX_TOKENS=8192
# auto：官方 Anthropic 使用原生 JSON Schema；DeepSeek 使用提示词和本地校验。
CLAUDE_STRUCTURED_OUTPUT=auto
# 填 API Key，或沿用启动环境已有的 ANTHROPIC_AUTH_TOKEN（API Bearer token）。
ANTHROPIC_API_KEY=
# ANTHROPIC_AUTH_TOKEN=

# 主持口播服务：fish / doubao / gemini / none；默认 fish，兼容原配置。
# 只读取所选服务的凭证；不会按已有密钥自动切换。所选服务无密钥时仅文字和音乐。
TTS_PROVIDER=fish

# 仅 Fish：到 https://fish.audio/app/api-keys/ 创建 API Key。
FISH_API_KEY=
FISH_MODEL=s2.1-pro-free
FISH_REFERENCE_ID=

# 仅豆包：使用新版“豆包语音”控制台 Key，不是火山方舟 / IAM Key。
# https://console.volcengine.com/speech/new/setting/apikeys?projectName=default
# 同一项目开通语音合成 2.0、创建 Key，并从音色库复制 Speaker ID。
# 不需要 App ID / Access Token / Secret Key；官方 2.0 音色与资源 ID 必须匹配。
DOUBAO_API_KEY=
DOUBAO_RESOURCE_ID=seed-tts-2.0
DOUBAO_SPEAKER=zh_female_vv_uranus_bigtts

# 仅 Gemini：到 https://aistudio.google.com/apikey 创建 Gemini API Key。
# 不需要 OAuth / App ID / Secret。本机运行时，运行 Radio 的电脑需在支持地区；当前列表不含中国大陆。
# 地区：https://ai.google.dev/gemini-api/docs/available-regions
# 免费额度和计费取决于 Google 当前政策及项目额度；lite 型号为 gemini-3.8-flash-lite-tts。
GEMINI_API_KEY=
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
# Kore 是预置音色名称，不是声音克隆 ID 或其他供应商的音色 ID。
GEMINI_TTS_VOICE=Kore
GEMINI_TTS_STYLE=温暖、自然、松弛的中文电台主持口吻

NETEASE_API_BASE_URL=http://127.0.0.1:3000
PORT=8080
